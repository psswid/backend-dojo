APP_NAME="Backend Dojo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Host port mapping for nginx (docker compose)
APP_PORT=8180

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (docker service "mysql") ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=backend_dojo
DB_USERNAME=dojo
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
FORWARD_DB_PORT=3307

# --- Redis (docker service "redis", predis client) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6380

# --- Cache / Session / Queue ---
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Meilisearch / Scout ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=dojo-master-key
FORWARD_MEILI_PORT=7700

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Agent (local Qwen3.6-35B-A3B, direct Mars endpoint) ---
# Mars llama.cpp serves OpenAI-compatible /v1 at port 11000. Start: ~/ai-cluster/cluster start mars
# (Alternative: LiteLLM proxy http://192.168.1.82:4001/v1 when Olympus LiteLLM is running.)
LLM_BASE_URL=http://host.docker.internal:11000/v1
LLM_API_KEY=local
LLM_MODEL=Qwen3.6-35B-A3B
LLM_TIMEOUT=180
# Liveness probe (short timeout, no auth)
LLM_HEALTH_URL=http://host.docker.internal:11000/health

# --- Code runner sandbox (snippet/debug tasks) ---
RUNNER_URL=http://runner:8080
RUNNER_TIMEOUT=15
